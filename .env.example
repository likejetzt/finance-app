# Kopieren nach .env und ausfüllen. Die .env niemals einchecken.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Inhalt ---
SOURCE_AUTHOR=Nicolas Boucher
ATTRIBUTION_LINE=Original von Nicolas Boucher, deutsche Fassung mit freundlicher Genehmigung.
MY_LINK=https://
LINK_LINE=Mehr dazu: {link}

# --- Planung ---
TIMEZONE=Europe/Berlin
# Feste Sendeplätze der Seite (Mo Di Mi Do Fr Sa So)
POST_SLOTS=Mo 08:30, Mo 12:30, Di 08:30, Di 12:30, Mi 08:30, Mi 12:30, Do 08:30, Do 12:30, Fr 08:30, Fr 12:30
# Wie oft der Eingangsordner und RSS geprüft werden (Minuten)
FETCH_INTERVAL_MINUTES=60
# Verpasste Termine (PC aus) werden nach so vielen Minuten auf den nächsten freien Platz verschoben
MISSED_GRACE_MINUTES=45
# true = Entwürfe werden ohne Prüfung automatisch eingeplant (nicht empfohlen)
AUTO_APPROVE=false
# Optional, kommagetrennt
RSS_URLS=
# Geteilter Ordner mit Nicolas' Beiträgen, z. B. aus Google Drive für Desktop:
# Im Explorer Rechtsklick auf den Ordner > "Als Pfad kopieren" und hier einfügen.
INBOX_DIR=

# --- Gestaltung der Grafiken ---
BRAND_PRIMARY=#0B2545
BRAND_ACCENT=#13A89E
BRAND_FONT='Inter', 'Helvetica Neue', Arial, sans-serif

# --- LinkedIn (Developer-App mit Community Management API) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/linkedin/callback
# Zahl aus der Admin-URL der Seite: linkedin.com/company/<ID>/admin
LINKEDIN_ORG_ID=
LINKEDIN_SCOPE=w_organization_social
# API-Version im Format JJJJMM; LinkedIn unterstützt jede Version ca. ein Jahr
LINKEDIN_VERSION=202609

# --- Weboberfläche ---
# Passwort für die Oberfläche (Benutzername beliebig). Pflicht, sobald die App im Internet erreichbar ist.
APP_PASSWORD=
SECRET_KEY=bitte-langen-zufallswert-eintragen

# Optional: vorhandenes Chromium statt "playwright install chromium"
# CHROMIUM_PATH=/usr/bin/chromium
